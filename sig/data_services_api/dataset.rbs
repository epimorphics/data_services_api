module DataServicesApi
  # Encapsulates a single dataset from the data services API
  class Dataset
    @json: untyped

    @service: untyped

    @structure: untyped

    attr_reader service: untyped

    def initialize: (untyped json, untyped service) -> void

    def id: () -> untyped

    def method_missing: (untyped attribute) -> untyped

    def respond_to_missing?: (untyped attribute, ?untyped? _args) -> untyped

    def data_api: () -> untyped

    def dataset: () -> untyped

    def structure_api: () -> untyped

    def describe_api: () -> untyped

    def explain_api: () -> untyped

    def structure: () -> untyped

    def query: (untyped query) -> untyped

    def describe: (untyped uri) -> untyped

    def explain: (untyped query) -> untyped
  end
end
